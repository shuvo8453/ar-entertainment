# =====================================================================
# AR Entertainment (.htaccess) - Clean SEO Routing & Performance
# Target: arentertainment.bd (Dual Support: XAMPP / Laragon / Production)
# =====================================================================

# 1. Server Security & Directory Options
Options -Indexes +FollowSymLinks
ServerSignature Off

# 2. Block Direct Access to Sensitive Files
<FilesMatch "(^\.|\.sql$|\.log$|\.env$|\.git|composer\.(json|lock)|package\.(json|lock))">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. URL Rewriting & Routing Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ar-entertainment/

    # Fallback RewriteBase detection if running on Virtual Host root
    <If "%{HTTP_HOST} =~ /^(www\.)?arentertainment\.bd$/ || %{HTTP_HOST} == 'ar-entertainment.test'">
        RewriteBase /
    </If>

    # -----------------------------------------------------------------
    # 3.1. Directory Index Order
    # -----------------------------------------------------------------
    DirectoryIndex index.php index.html

    # -----------------------------------------------------------------
    # 3.2. 301 Permanent Redirects for Clean URLs (Strip index.php & .html)
    # -----------------------------------------------------------------
    # Redirect root /index.html and /index.php to ./
    RewriteCond %{THE_REQUEST} \s/+(?:ar-entertainment/)?index\.(html|php)[\s?] [NC]
    RewriteRule ^index\.(html|php)$ ./ [R=301,L,NE]

    # Redirect subfolder /index.php to subfolder / (e.g. /admin/blogs/index.php -> /admin/blogs/)
    RewriteCond %{THE_REQUEST} \s/+(?:ar-entertainment/)?(.+?)/index\.php[\s?] [NC]
    RewriteRule ^(.+?)/index\.php$ $1/ [R=301,L,NE]

    # Strip .html extension from direct requests to preserve SEO equity
    RewriteCond %{THE_REQUEST} \s/+(?:ar-entertainment/)?([^\s?]+)\.html[\s?] [NC]
    RewriteRule ^(.+)\.html$ $1 [R=301,L,NE]

    # -----------------------------------------------------------------
    # 3.3. Pass-through Real Files and Static Directories
    # -----------------------------------------------------------------
    RewriteRule ^uploads(/.*)?$ - [L]
    RewriteRule ^inc(/.*)?$ - [L]
    RewriteRule ^images(/.*)?$ - [L]

    # Pass-through real static files (css, js, images, fonts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # -----------------------------------------------------------------
    # 3.4. Clean SEO Frontend Routes (PHP dynamic with HTML fallback)
    # -----------------------------------------------------------------
    # Homepage
    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/index.php -f [OR]
    RewriteCond index.php -f
    RewriteRule ^$ index.php [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/index.html -f [OR]
    RewriteCond index.html -f
    RewriteRule ^$ index.html [L,QSA]

    # XML Sitemap
    RewriteCond sitemap.php -f
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Blog Routes
    RewriteCond blog.php -f
    RewriteRule ^blog/?$ blog.php [L,QSA]
    RewriteCond blog-single.php -f
    RewriteRule ^blog/([^/]+)/?$ blog-single.php?slug=$1 [L,QSA]

    # Services Routes
    RewriteCond services.php -f
    RewriteRule ^services/?$ services.php [L,QSA]
    RewriteCond service-single.php -f
    RewriteRule ^services/([^/]+)/([^/]+)/?$ service-single.php?category=$1&slug=$2 [L,QSA]
    RewriteCond service-single.php -f
    RewriteRule ^services/([^/]+)/?$ service-single.php?slug=$1 [L,QSA]

    # AI Production Hub Routes
    RewriteCond ai.php -f
    RewriteRule ^ai/?$ ai.php [L,QSA]
    RewriteCond ai-single.php -f
    RewriteRule ^ai/([^/]+)/?$ ai-single.php?slug=$1 [L,QSA]

    # Portfolio Routes
    RewriteCond portfolio.php -f
    RewriteRule ^portfolio/?$ portfolio.php [L,QSA]
    RewriteCond portfolio-single.php -f
    RewriteRule ^portfolio/([^/]+)/?$ portfolio-single.php?slug=$1 [L,QSA]

    # District Service Area Guides
    RewriteCond service-area.php -f
    RewriteRule ^service-area/?$ service-area.php [L,QSA]
    RewriteCond service-area-single.php -f
    RewriteRule ^service-area/([^/]+)/?$ service-area-single.php?district=$1 [L,QSA]

    # Brands & Clients
    RewriteCond brands.php -f
    RewriteRule ^brands/?$ brands.php [L,QSA]
    RewriteCond brand-single.php -f
    RewriteRule ^brands/([^/]+)/?$ brand-single.php?slug=$1 [L,QSA]

    # About Us & Subpages
    RewriteCond about-us.php -f
    RewriteRule ^about-us/?$ about-us.php [L,QSA]
    RewriteCond why-choose-us.php -f
    RewriteRule ^about-us/why-choose-us/?$ why-choose-us.php [L,QSA]
    RewriteCond careers.php -f
    RewriteRule ^about-us/careers/?$ careers.php [L,QSA]
    RewriteCond partners.php -f
    RewriteRule ^about-us/partners/?$ partners.php [L,QSA]
    RewriteCond contact-us.php -f
    RewriteRule ^about-us/contact-us/?$ contact-us.php [L,QSA]

    # Fallback to corresponding .html templates when dynamic .php does not exist yet
    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/$1.php !-f
    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/$1.html -f
    RewriteRule ^(about-us|services|portfolio|ai|brands|service-area|blog)/?$ $1.html [L,QSA]

    # Sub-pages in about-us/
    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/about-us/$1.php !-f
    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/about-us/$1.html -f
    RewriteRule ^about-us/([^/]+)/?$ about-us/$1.html [L,QSA]

    # -----------------------------------------------------------------
    # 3.5. Multi-level Clean URL Route Resolution (Admin & Static Fallbacks)
    # -----------------------------------------------------------------
    # If directory without trailing slash, redirect to trailing slash
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ $1/ [R=301,L]

    # If directory exists, let DirectoryIndex serve index.php or index.html
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # If extensionless .php file exists in current path or subdirectories
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    # If extensionless .html file exists in current path (template fallback before Phase 5)
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L,QSA]
</IfModule>

# 4. Gzip / Deflate Compression for Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5. Browser Caching Headers (mod_expires)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 6. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
