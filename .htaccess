# =====================================================================
# AR Entertainment - Universal Routing (.htaccess)
# =====================================================================

# 1. Directory Options & Index
Options -Indexes +FollowSymLinks
DirectoryIndex index.php index.html

# 2. Character Encoding
AddDefaultCharset UTF-8

# 3. URL Rewriting Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ar-entertainment/

    # -----------------------------------------------------------------
    # 3.1. Universal Asset Routing (Prevents broken CSS/JS/Images on nested pages)
    # Any subpath requesting /inc/, /images/, or /uploads/ routes to root assets
    # -----------------------------------------------------------------
    RewriteRule ^(?:.+?/)*(inc/.*)$ $1 [L,QSA]
    RewriteRule ^(?:.+?/)*(images/.*)$ $1 [L,QSA]
    RewriteRule ^(?:.+?/)*(uploads/.*)$ $1 [L,QSA]

    RewriteRule ^(inc|images|uploads)/ - [L]

    # -----------------------------------------------------------------
    # 3.2. Fix duplicate nested folder clicks (e.g. /meet-the-team/meet-the-team/file -> /meet-the-team/file)
    # -----------------------------------------------------------------
    RewriteRule ^(.+?)/meet-the-team/meet-the-team/(.*)$ $1/meet-the-team/$2 [R=301,L]
    RewriteRule ^meet-the-team/meet-the-team/(.*)$ meet-the-team/$1 [R=301,L]

    # -----------------------------------------------------------------
    # 3.3. Dynamic Blog System Routing
    # -----------------------------------------------------------------
    # Legacy .html single blog redirect: /blog/{slug}.html -> /blog/{slug}
    RewriteRule ^blog/([a-zA-Z0-9_-]+)\.html$ blog/$1 [R=301,L]

    # Main Blog Listing: /blog or /blog/ -> blog.php
    RewriteRule ^blog/?$ blog.php [L,QSA]

    # Single Blog Article: /blog/{slug} -> blog-single.php?slug=$1
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-single.php?slug=$1 [L,QSA]

    # -----------------------------------------------------------------
    # 3.4. Dynamic Services System Routing
    # -----------------------------------------------------------------
    # Legacy .html single service redirect: /services/{slug}.html -> /services/{slug}
    RewriteRule ^services/([a-zA-Z0-9_-]+)\.html$ services/$1 [R=301,L]

    # Main Services Listing: /services or /services/ -> services.php
    RewriteRule ^services/?$ services.php [L,QSA]

    # Single Service: /services/{slug} -> service-single.php?slug=$1
    RewriteRule ^services/([a-zA-Z0-9_-]+)/?$ service-single.php?slug=$1 [L,QSA]

    # -----------------------------------------------------------------
    # 3.5. Dynamic Portfolio System Routing
    # -----------------------------------------------------------------
    # Legacy .html portfolio redirects
    RewriteRule ^portfolio\.html$ portfolio [R=301,L]
    RewriteRule ^portfolio/([a-zA-Z0-9_-]+)\.html$ portfolio?category=$1 [R=301,L]

    # Main Portfolio Listing: /portfolio or /portfolio/ -> portfolio.php
    RewriteRule ^portfolio/?$ portfolio.php [L,QSA]

    # -----------------------------------------------------------------
    # 3.6. Real Physical Files Pass-Through
    # -----------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # -----------------------------------------------------------------
    # 3.3. Directories with an index file (e.g. admin/, online-video-commercial/)
    # -----------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^ - [L]

    # -----------------------------------------------------------------
    # 3.4. Match corresponding .php or .html file (handles directory name without index)
    # e.g. /about-us/meet-the-team/ -> about-us/meet-the-team.html
    # e.g. /about-us/ -> about-us.html
    # e.g. /services/ -> services.html
    # e.g. /portfolio/ -> portfolio.html
    # e.g. /blog/ -> blog.html
    # e.g. /brands/ -> brands.html
    # -----------------------------------------------------------------
    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/$1.php -f [OR]
    RewriteCond $1.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/$1.html -f [OR]
    RewriteCond $1.html -f [OR]
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L,QSA]

    # -----------------------------------------------------------------
    # 3.5. Root Shortcuts to Subfolder Pages (e.g. /meet-the-team -> about-us/meet-the-team.html)
    # -----------------------------------------------------------------
    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/about-us/$1.php -f [OR]
    RewriteCond about-us/$1.php -f
    RewriteRule ^([^/]+)/?$ about-us/$1.php [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/about-us/$1.html -f [OR]
    RewriteCond about-us/$1.html -f
    RewriteRule ^([^/]+)/?$ about-us/$1.html [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/services/$1.php -f [OR]
    RewriteCond services/$1.php -f
    RewriteRule ^([^/]+)/?$ services/$1.php [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/services/$1.html -f [OR]
    RewriteCond services/$1.html -f
    RewriteRule ^([^/]+)/?$ services/$1.html [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/portfolio/$1.php -f [OR]
    RewriteCond portfolio/$1.php -f
    RewriteRule ^([^/]+)/?$ portfolio/$1.php [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/portfolio/$1.html -f [OR]
    RewriteCond portfolio/$1.html -f
    RewriteRule ^([^/]+)/?$ portfolio/$1.html [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/ai/$1.php -f [OR]
    RewriteCond ai/$1.php -f
    RewriteRule ^([^/]+)/?$ ai/$1.php [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/ai/$1.html -f [OR]
    RewriteCond ai/$1.html -f
    RewriteRule ^([^/]+)/?$ ai/$1.html [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/blog/$1.php -f [OR]
    RewriteCond blog/$1.php -f
    RewriteRule ^([^/]+)/?$ blog/$1.php [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/ar-entertainment/blog/$1.html -f [OR]
    RewriteCond blog/$1.html -f
    RewriteRule ^([^/]+)/?$ blog/$1.html [L,QSA]
</IfModule>
